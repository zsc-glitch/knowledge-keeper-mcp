{
  "name": "knowledge-keeper-mcp",
  "version": "1.4.2",
  "description": "AI Memory & Knowledge Management — 30 MCP tools, BM25 + hybrid search, knowledge graph, Obsidian compatible, zero API keys",
  "author": "小影 (zsc-glitch)",
  "repository": "https://github.com/zsc-glitch/knowledge-keeper-mcp",
  "homepage": "https://zsc-glitch.github.io/knowledge-keeper-mcp/",
  "license": "MIT",
  "tags": ["mcp", "memory", "knowledge", "search", "obsidian", "bm25", "graph", "cloud-sync", "audit"],
  "tools": [
    "knowledge_save",
    "knowledge_get", 
    "knowledge_update",
    "knowledge_delete",
    "knowledge_search",
    "knowledge_semantic_search",
    "knowledge_bm25_search",
    "knowledge_hybrid_search",
    "knowledge_tags",
    "knowledge_versions",
    "knowledge_review",
    "knowledge_link",
    "knowledge_unlink",
    "knowledge_get_linked",
    "knowledge_graph",
    "knowledge_graph_build",
    "knowledge_graph_query",
    "knowledge_graph_visualize",
    "knowledge_export",
    "knowledge_import",
    "knowledge_batch",
    "knowledge_sync",
    "knowledge_merge",
    "knowledge_bm25_stats",
    "knowledge_audit",
    "knowledge_analytics_overview",
    "knowledge_analytics_insights",
    "knowledge_analytics_timeline",
    "knowledge_sync_status",
    "knowledge_license"
  ],
  "compatibility": {
    "claude-code": true,
    "cursor": true,
    "gemini-cli": true,
    "windsurf": true,
    "hermes-agent": true,
    "openclaw": true
  },
  "install": {
    "npm": "npm install @zsc-glitch/knowledge-keeper-mcp",
    "claude-code": "claude mcp add knowledge-keeper -- npx @zsc-glitch/knowledge-keeper-mcp",
    "cursor": "Add to MCP config: {\"mcpServers\":{\"knowledge-keeper\":{\"command\":\"npx\",\"args\":[\"@zsc-glitch/knowledge-keeper-mcp\"]}}}",
    "gemini-cli": "Add to MCP config: {\"mcpServers\":{\"knowledge-keeper\":{\"command\":\"npx\",\"args\":[\"@zsc-glitch/knowledge-keeper-mcp\"]}}}"
  },
  "features": [
    "30 MCP tools for complete knowledge management",
    "Hybrid search: BM25 keyword + TF-IDF semantic + RRF fusion",
    "Knowledge graph with entity detection and Mermaid visualization",
    "Obsidian vault compatible (read/write)",
    "Spaced repetition review scheduler",
    "SHA256 audit trail for compliance",
    "Version history with diff and rollback",
    "End-to-end encrypted cloud sync (Pro)",
    "Zero AI dependency — no API keys needed",
    "Knowledge analytics: overview, insights, timeline"
  ],
  "benchmark": {
    "bm25_recall_at_5": "95%",
    "hybrid_recall_at_5": "97%+",
    "search_improvement": "10-100x faster with index caching"
  }
}
