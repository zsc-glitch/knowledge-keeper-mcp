{
  "name": "@zsc-glitch/knowledge-keeper-mcp",
  "version": "1.7.3",
  "description": "AI Memory & Knowledge Management MCP Server — 32 tools, BM25 R@5=95%, hybrid search (RRF), knowledge graph, analytics, cloud sync, Obsidian compatible. Works with Claude Code, Cursor, Gemini CLI, Windsurf, hermes-agent.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "knowledge-keeper-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && sed -i '1i#!/usr/bin/env node' dist/index.js",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "node --test src/core.test.js src/bm25.test.js src/embedding.test.js src/search.test.js src/tags.test.js src/versions.test.js src/link.test.js src/graph.test.js src/review.test.js src/export.test.js src/cloud-sync.test.js src/analytics.test.js",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "memory",
    "knowledge",
    "knowledge-graph",
    "ai",
    "claude-code",
    "cursor",
    "gemini-cli",
    "windsurf",
    "hermes-agent",
    "openclaw",
    "obsidian",
    "bm25",
    "semantic-search",
    "knowledge-management",
    "ai-memory",
    "rag",
    "byterover-alternative",
    "freemium",
    "commercial-use",
    "mempalace-alternative",
    "memU-alternative",
    "local-first",
    "zero-api",
    "tf-idf",
    "hybrid-search",
    "rrf",
    "spaced-repetition",
    "version-history",
    "audit-trail",
    "long-term-memory",
    "agent-memory",
  "context-explorer",
  "duplicate-detection",
  "cloud-sync",
  "knowledge-base",
  "personal-knowledge",
  "second-brain",
  "mcp-server",
  "mcp-tools"
  ],
  "author": "小影 <zsc-glitch>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zsc-glitch/knowledge-keeper-mcp.git"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/server": "2.0.0-alpha.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "typescript": "^5.8.0",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
